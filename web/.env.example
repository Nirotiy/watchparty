# Server-side HTTP proxy target. In local development this defaults to the
# backend on port 8080; in Compose it is set to http://backend:8080.
# BACKEND_ORIGIN=http://localhost:8080

# Optional development override. Production should leave this unset and route
# /socket.io through the same-origin reverse proxy.
# NEXT_PUBLIC_SOCKET_ORIGIN=http://localhost:8080
