# WatchParty reverse-proxy example. Only /p/* (media stream), /api/* and
# /socket.io/* are exposed; the OpenList admin UI stays off the public network.
watch.example.test {
  # Gate 1 / Basic Auth option A: keep the site-wide auth boundary.
  # DesktopSession supplies this credential in native memory for API and /p/*
  # fallback requests; it is never passed to the WebView or placed in a URL.
  basic_auth {
    alice $2a$14$REPLACE_WITH_CADDY_HASH
  }

  # OpenList streaming proxy published same-origin: <video> stays behind the
  # same Basic Auth, no mixed content, no CORS. Requires the OpenList storage
  # to keep web_proxy enabled (Baidu needs the proxy for its UA requirement).
  handle /p/* {
    reverse_proxy 127.0.0.1:5244
  }

  # This includes browser, MPV, and desktop handoff/session endpoints.
  # Do not exempt /api/desktop/* from this site-wide auth without revising the
  # native credential contract and its security review.
  handle /api/* {
    reverse_proxy 127.0.0.1:8080
  }

  handle /socket.io/* {
    reverse_proxy 127.0.0.1:8080
  }

  handle {
    reverse_proxy 127.0.0.1:3000
  }
}
