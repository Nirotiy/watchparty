# Old Vite UI (src/). Leave blank to skip Firebase login on the client.
VITE_FIREBASE_CONFIG=
# VITE_SERVER_HOST=http://localhost:8080

# Core server. All of these are optional.
# PORT=8080
# HOST=0.0.0.0
# YOUTUBE_API_KEY=REPLACE_ME
# ROOM_IDLE_TTL_MS=28800000
# ROOM_PRUNE_INTERVAL_MS=60000
# SSL_KEY_FILE=
# SSL_CRT_FILE=
# BUILD_DIRECTORY=build
# OpenList adapter. WatchParty connects to OpenList directly; video bytes are never proxied.
# OPENLIST_URL=http://127.0.0.1:5244
# OPENLIST_USERNAME=admin
# OPENLIST_PASSWORD=
# OPENLIST_REQUEST_TIMEOUT_MS=10000
# mediaId signing key. REQUIRED in production (NODE_ENV=production refuses to
# start without it); in dev a random per-process key is generated.
# WATCHPARTY_MEDIA_ID_KEY=REPLACE_ME
# Browser-facing OpenList origin. Defaults to OPENLIST_URL. Origin only — path
# prefixes are not supported; publish OpenList at the domain root via Caddy.
# OPENLIST_PUBLIC_URL=https://watch.example.com
# Only a loopback proxy may select one of these exact origins for /p/* media.
# WATCHPARTY_MEDIA_PUBLIC_ORIGINS=https://watch.example.com,https://203.0.113.1:8443
# Local Docker Compose ports only.
# WATCHPARTY_BACKEND_PORT=8080
# WATCHPARTY_FRONTEND_PORT=3000
